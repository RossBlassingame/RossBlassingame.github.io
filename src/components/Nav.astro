---
import SocialLinks from './SocialLinks.astro';

// Top-of-page nav. Mono font for a typographic SWE accent.
// Current-page detection compares the trimmed pathname to each item's match.
// Mobile collapses to a single row of text links — no hamburger.
const items = [
  { label: '~', href: '/', match: '/' },
  { label: 'Projects', href: '/projects/', match: '/projects' },
  { label: 'Writing', href: '/blog/', match: '/blog' },
  { label: 'Now', href: '/now/', match: '/now' },
  { label: 'About', href: '/about/', match: '/about' },
] as const;

// Normalize: ensure leading slash, strip trailing slash except for root.
// Centralized here so item `match` strings can be the canonical no-slash
// form (`/blog`) and we never need to spell out both variants per item.
function trimSlash(p: string): string {
  return p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p;
}
const currentPath = trimSlash(Astro.url.pathname);

function isCurrent(match: string) {
  // For non-root items, also match nested routes (e.g. /blog/foo → Writing).
  const m = trimSlash(match);
  if (m === '/') return currentPath === '/';
  return currentPath === m || currentPath.startsWith(m + '/');
}
---
<nav aria-label="Primary" class="mb-12 flex flex-wrap items-center justify-between gap-4 font-mono text-sm">
  <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
    {items.map(({ label, href, match }) => {
      const current = isCurrent(match);
      return (
        <li>
          <a
            href={href}
            aria-current={current ? 'page' : undefined}
            class:list={[
              'inline-block py-1 transition-opacity hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] rounded-sm',
              current
                ? 'text-[var(--color-accent)]'
                : 'text-[var(--color-muted)] opacity-90 hover:text-[var(--color-fg)]',
            ]}
          >
            {label}
          </a>
        </li>
      );
    })}
  </ul>
  <SocialLinks size={16} class="hidden sm:flex" />
</nav>
