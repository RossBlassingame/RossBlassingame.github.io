---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---
<Base
  title="Projects — Ross Blassingame"
  description="Selected work projects: device telemetry infrastructure, AI tooling, and consent frameworks."
>
  <header>
    <h1 class="text-4xl font-semibold tracking-tight">Projects</h1>
    <p class="mt-3 font-mono text-xs text-[var(--color-muted)] leading-relaxed">
      All work projects — internal Amazon links omitted.
    </p>
  </header>

  <div class="mt-10">
    {projects.map((p) => (
      <ProjectCard
        title={p.title}
        years={p.years}
        summary={p.summary}
        tags={p.tags}
      />
    ))}
  </div>
</Base>
