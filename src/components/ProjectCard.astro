---
// A single project entry: title, year range, summary, tech tag list.
// Year range and tags use mono so they read as metadata, not body copy.
export interface Props {
  title: string;
  years: string;
  summary: string;
  tags: readonly string[];
}
const { title, years, summary, tags } = Astro.props;
---
<article class="border-t border-[var(--color-border)] py-6 first:border-t-0 first:pt-0">
  <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-lg font-semibold tracking-tight text-[var(--color-fg)]">
      {title}
    </h3>
    <span class="font-mono text-xs uppercase tracking-wider text-[var(--color-muted)]">
      {years}
    </span>
  </header>
  <p class="mt-2 text-[var(--color-fg)]/90 leading-relaxed">{summary}</p>
  {tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-1 font-mono text-xs text-[var(--color-muted)]">
      {tags.map((tag) => (
        <li class="rounded border border-[var(--color-border)] px-2 py-0.5">{tag}</li>
      ))}
    </ul>
  )}
</article>
