---
import Base from './Base.astro';
import { formatPostDate, isoDate } from '../lib/date';

// Layout used for individual blog post pages. Wraps the rendered MDX
// in a `prose` block (Tailwind Typography) so headings/lists/code blocks
// inherit consistent styling, and prepends a header with title + date.
export interface Props {
  title: string;
  description?: string;
  date: Date;
}
const { title, description, date } = Astro.props;
---
<Base title={`${title} — Ross Blassingame`} description={description}>
  <article>
    <header class="mb-8">
      <time
        datetime={isoDate(date)}
        class="block font-mono text-xs uppercase tracking-wider text-[var(--color-muted)]"
      >
        {formatPostDate(date)}
      </time>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
    </header>
    <div class="prose prose-invert prose-headings:tracking-tight prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline prose-code:font-mono prose-pre:rounded-md prose-pre:border prose-pre:border-[var(--color-border)] max-w-none">
      <slot />
    </div>
    <p class="mt-12 font-mono text-xs text-[var(--color-muted)]">
      <a
        href="/blog/"
        class="hover:text-[var(--color-fg)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] rounded-sm"
      >
        ← all writing
      </a>
    </p>
  </article>
</Base>
