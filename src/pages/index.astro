---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { projects } from '../data/projects';

// Featured projects on the homepage = first 3 from the shared list.
const featured = projects.slice(0, 3);

// Latest writing: hide drafts, sort newest first, cap at 3 on the home page.
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<Base
  title="Ross Blassingame"
  description="Software engineer in Denver. Currently at Amazon, working on device telemetry infrastructure and AI tooling."
>
  <header>
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Ross Blassingame</h1>
    <p class="mt-4 text-lg text-[var(--color-fg)]/90 leading-relaxed">
      Software engineer in Denver. Currently at Amazon, working on device telemetry infrastructure and AI tooling.
    </p>
  </header>

  <Section title="About">
    <p class="text-[var(--color-fg)]/90 leading-relaxed">
      I'm a software engineer at Amazon in Denver. I build device telemetry infrastructure at trillion-metric-per-day scale and AI tooling that the engineering org uses to ship code faster. Outside work I climb mountains, run, hunt, and read.
    </p>
  </Section>

  <Section title="Selected projects" href="/projects/">
    <div>
      {featured.map((p) => (
        <ProjectCard
          title={p.title}
          years={p.years}
          summary={p.summary}
          tags={p.tags}
        />
      ))}
    </div>
  </Section>

  <Section title="Writing" href="/blog/">
    <PostList posts={latestPosts} />
  </Section>

  <Section title="Now" href="/now/" linkLabel="full now page">
    <p class="text-[var(--color-fg)]/90 leading-relaxed">
      Leading the developer-experience pillar on Device Metrics — console modernization, control plane API rearchitecture, IDE integration — and shipping AI tooling the broader org uses day to day. Outside: marathon training, fourteener targets for the summer, archery elk in the fall.
    </p>
  </Section>

  <Section title="Elsewhere">
    <SocialLinks size={20} />
  </Section>
</Base>
