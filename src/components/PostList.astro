---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate, isoDate } from '../lib/date';

// Renders a list of blog posts with date + title + optional description.
// Date uses <time datetime> for machine-readable semantics; surface
// formatting comes from the shared `formatPostDate` helper so list and
// detail views always agree.
//
// `as` controls the heading level for each post title. Default `h2` is
// correct on a standalone index page (where the page <h1> sits above us).
// Pass `as="h3"` when this list is rendered inside a `<Section>` whose
// kicker is already `<h2>` (e.g. on the homepage), so the outline goes
// h1 → h2 (Section) → h3 (post titles) without skipping.
export interface Props {
  posts: CollectionEntry<'posts'>[];
  as?: 'h2' | 'h3';
}
const { posts, as: HeadingTag = 'h2' } = Astro.props;
---
{posts.length === 0 ? (
  <p class="text-[var(--color-muted)]">No posts yet.</p>
) : (
  <ul class="flex flex-col gap-6">
    {posts.map((post) => (
      <li>
        <article>
          <a
            href={`/blog/${post.id}/`}
            class="group inline-block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] rounded-sm"
          >
            <time
              datetime={isoDate(post.data.date)}
              class="block font-mono text-xs uppercase tracking-wider text-[var(--color-muted)]"
            >
              {formatPostDate(post.data.date)}
            </time>
            <HeadingTag class="mt-1 text-lg font-semibold tracking-tight text-[var(--color-fg)] transition-colors group-hover:text-[var(--color-accent)]">
              {post.data.title}
            </HeadingTag>
          </a>
          {post.data.description && (
            <p class="mt-1 text-[var(--color-muted)] leading-relaxed">
              {post.data.description}
            </p>
          )}
        </article>
      </li>
    ))}
  </ul>
)}
