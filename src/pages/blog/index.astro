---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';

// Hide drafts at build time, sort newest first.
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---
<Base
  title="Writing — Ross Blassingame"
  description="Notes from Ross Blassingame, software engineer in Denver."
>
  <header>
    <h1 class="text-4xl font-semibold tracking-tight">Writing</h1>
    <p class="mt-3 font-mono text-xs text-[var(--color-muted)] leading-relaxed">
      Posts on engineering, tooling, and the occasional aside. Subscribe via
      <a
        href="/rss.xml"
        class="underline hover:text-[var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] rounded-sm"
      >RSS</a>.
    </p>
  </header>

  <div class="mt-10">
    <PostList posts={posts} />
  </div>
</Base>
